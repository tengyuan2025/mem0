# Mem0 生产环境配置模板
# 复制此文件为 .env.production 并填入真实的值

# ========================
# 基础配置
# ========================

# 环境标识
ENVIRONMENT=production

# 应用版本（CI/CD自动设置）
VERSION=latest

# 构建信息（CI/CD自动设置）
BUILD_DATE=
VCS_REF=

# ========================
# 安全配置
# ========================

# API密钥（必须设置，建议使用强随机字符串）
API_SECRET_KEY=your-super-secret-api-key-here

# JWT配置
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ========================
# 数据库配置
# ========================

# PostgreSQL主数据库
POSTGRES_USER=mem0
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_DB=mem0_db
POSTGRES_PORT=5432

# Redis缓存
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ========================
# 向量数据库配置
# ========================

# ChromaDB配置
CHROMA_PORT=8001
CHROMA_AUTH_PROVIDER=chromadb.auth.token.TokenAuthServerProvider
CHROMA_AUTH_CREDENTIALS=your-chroma-auth-token

# ========================
# LLM服务配置
# ========================

# LLM提供商选择 (openai/deepseek/dashscope/qianfan/zhipu)
MEM0_LLM_PROVIDER=deepseek
MEM0_LLM_MODEL=deepseek-chat

# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key

# DashScope API (阿里云)
DASHSCOPE_API_KEY=your-dashscope-api-key

# 千帆 API (百度)
QIANFAN_ACCESS_KEY=your-qianfan-access-key
QIANFAN_SECRET_KEY=your-qianfan-secret-key

# 智谱AI API
ZHIPUAI_API_KEY=your-zhipuai-api-key

# ========================
# 嵌入模型配置
# ========================

# 嵌入模型提供商
MEM0_EMBEDDER_PROVIDER=sentence_transformers

# 嵌入模型名称（建议使用轻量级中文模型）
MEM0_EMBEDDER_MODEL=shibing624/text2vec-base-chinese

# 嵌入模型配置
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

# ========================
# 向量存储配置
# ========================

# 向量存储提供商 (chroma/qdrant/faiss)
MEM0_VECTOR_STORE_PROVIDER=chroma
MEM0_VECTOR_STORE_TYPE=persistent

# ChromaDB持久化目录
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ========================
# 应用服务配置
# ========================

# 应用监听配置
APP_HOST=0.0.0.0
APP_PORT=9000

# Uvicorn工作进程数
UVICORN_WORKERS=4

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========================
# Web服务配置
# ========================

# Nginx端口
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 域名配置
PRIMARY_DOMAIN=api.yourdomain.com
MONITOR_DOMAIN=monitor.yourdomain.com

# ========================
# 监控配置
# ========================

# 启用监控指标
ENABLE_METRICS=true
METRICS_PORT=9090

# Prometheus配置
PROMETHEUS_PORT=9091

# Grafana配置
GRAFANA_PORT=3000
GRAFANA_PASSWORD=your-grafana-admin-password

# ========================
# 存储配置
# ========================

# 数据目录
MEM0_DIR=/app/data

# HuggingFace模型缓存
HF_HOME=/app/data/huggingface
TRANSFORMERS_CACHE=/app/data/transformers

# 备份目录
BACKUP_DIR=/app/backups

# ========================
# 性能优化配置
# ========================

# 数据库连接池
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Redis连接池
REDIS_POOL_SIZE=10
REDIS_CONNECTION_TIMEOUT=5

# HTTP客户端配置
HTTP_TIMEOUT=30
HTTP_MAX_CONNECTIONS=100

# ========================
# 功能开关
# ========================

# 启用功能标志
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true
ENABLE_COMPRESSION=true
ENABLE_HEALTH_CHECK=true

# 调试模式（生产环境建议设为false）
DEBUG=false

# ========================
# 外部服务配置
# ========================

# 邮件服务（用于告警通知）
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_TLS=true

# 消息队列（可选）
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ========================
# 告警配置
# ========================

# 告警接收邮箱
ALERT_EMAIL=admin@yourdomain.com

# Slack Webhook（可选）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# 钉钉Webhook（可选）
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN

# ========================
# 备份和恢复配置
# ========================

# 自动备份配置
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨2点

# 云存储备份（可选）
S3_BUCKET=your-backup-bucket
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=us-east-1

# ========================
# 开发和测试配置
# ========================

# 测试数据库（仅测试环境）
TEST_DATABASE_URL=sqlite:///./test.db

# 性能测试配置
ENABLE_PROFILING=false
PROFILING_OUTPUT_DIR=/app/profiles