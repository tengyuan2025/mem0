name: Mem0 简化部署

on:
  push:
    branches: [ main, develop, daily/* ]
    tags: [ 'v*' ]

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  # 基础检查和测试
  test:
    name: 测试
    runs-on: ubuntu-latest
    
    steps:
    - name: 检出代码
      uses: actions/checkout@v4
      
    - name: 设置Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.11'
        cache: 'pip'
        
    - name: 安装依赖
      run: |
        python -m pip install --upgrade pip
        pip install fastapi uvicorn[standard] pydantic python-dotenv loguru httpx
        pip install python-jose[cryptography] passlib[bcrypt]
        pip install sentence-transformers || echo "sentence-transformers安装失败，跳过"
        pip install chromadb || echo "chromadb安装失败，跳过"
        pip install sqlalchemy pymysql || echo "数据库依赖安装失败，跳过"
        
    - name: 运行单元测试
      continue-on-error: true
      run: |
        echo "🧪 运行单元测试..."
        python test_unit.py
        echo "✅ 单元测试完成"

  # 直接部署到服务器
  deploy:
    name: 部署应用
    runs-on: ubuntu-latest
    needs: test
    if: github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/heads/daily/') || startsWith(github.ref, 'refs/tags/v')
    
    steps:
    - name: 检出代码
      uses: actions/checkout@v4
      
    - name: 检查SSH配置
      run: |
        if [ -z "${{ secrets.SSH_HOST }}" ]; then
          echo "❌ 未配置 SSH_HOST"
          exit 1
        fi
        if [ -z "${{ secrets.SSH_PRIVATE_KEY }}" ]; then
          echo "❌ 未配置 SSH_PRIVATE_KEY"
          exit 1
        fi
        echo "✅ SSH配置检查通过"
    
    - name: 部署到服务器
      env:
        SSH_HOST: ${{ secrets.SSH_HOST }}
        SSH_USER: ${{ secrets.SSH_USER || 'root' }}
        SSH_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
      run: |
        echo "📡 连接到服务器 $SSH_HOST"
        
        # 设置SSH
        mkdir -p ~/.ssh
        echo "$SSH_KEY" > ~/.ssh/deploy_key
        chmod 600 ~/.ssh/deploy_key
        ssh-keyscan -H $SSH_HOST >> ~/.ssh/known_hosts 2>/dev/null
        
        # 测试连接
        echo "🔍 测试SSH连接..."
        ssh -i ~/.ssh/deploy_key -o ConnectTimeout=10 $SSH_USER@$SSH_HOST "echo '✅ SSH连接成功'"
        
        # 检查Docker
        echo "🐳 检查Docker环境..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "docker --version && docker ps"
        
        # 准备服务器目录
        echo "📂 准备服务器目录..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "mkdir -p /opt/mem0/{data,logs,backups}"
        
        # 停止旧容器
        echo "🛑 停止旧容器..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "docker stop mem0-api 2>/dev/null || true"
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "docker rm mem0-api 2>/dev/null || true"
        
        # 备份配置
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "[ -f /opt/mem0/.env ] && cp /opt/mem0/.env /opt/mem0/data/.env.backup || true"
        
        # 打包并传输代码
        echo "🚀 打包并传输代码到服务器..."
        
        # 创建临时目录并打包代码
        TEMP_DIR=$(mktemp -d)
        cp -r . "$TEMP_DIR/mem0"
        cd "$TEMP_DIR/mem0"
        
        # 清理不需要的文件
        rm -rf .git data logs backups .env __pycache__ *.pyc node_modules
        find . -name "*.pyc" -delete
        find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
        
        # 打包代码
        cd "$TEMP_DIR"
        tar czf mem0-deploy.tar.gz mem0/
        
        # 传输到服务器
        scp -i ~/.ssh/deploy_key -o StrictHostKeyChecking=no mem0-deploy.tar.gz $SSH_USER@$SSH_HOST:/tmp/
        
        # 清理本地临时文件
        rm -rf "$TEMP_DIR"
        
        # 在服务器上执行部署
        echo "🔧 配置和启动服务..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST << 'EOF'
          set -e
          
          # 解压代码到生产目录
          echo "📦 解压代码..."
          cd /tmp
          tar xzf mem0-deploy.tar.gz
          
          # 同步到生产目录（保留数据目录）
          echo "🔄 同步到生产目录..."
          if [ -d "/opt/mem0/data" ]; then
            echo "保留现有数据目录"
          fi
          
          # 创建备份
          if [ -d "/opt/mem0" ]; then
            mv /opt/mem0 /opt/mem0.backup.$(date +%Y%m%d_%H%M%S) 2>/dev/null || true
          fi
          
          # 移动新代码
          mv mem0 /opt/mem0
          
          # 恢复数据目录
          if [ -d "/opt/mem0.backup."* ]; then
            BACKUP_DIR=$(ls -d /opt/mem0.backup.* | tail -1)
            if [ -d "$BACKUP_DIR/data" ]; then
              cp -r "$BACKUP_DIR/data" /opt/mem0/ 2>/dev/null || true
            fi
            if [ -f "$BACKUP_DIR/.env" ]; then
              cp "$BACKUP_DIR/.env" /opt/mem0/ 2>/dev/null || true
            fi
          fi
          
          # 清理临时文件
          rm -f /tmp/mem0-deploy.tar.gz
          
          cd /opt/mem0
          
          # 配置环境
          echo "⚙️ 配置环境..."
          if [ -f ".env.server" ]; then
            cp .env.server .env
          elif [ -f ".env.production.template" ]; then
            cp .env.production.template .env
          fi
          
          # 替换API密钥
          if [ ! -z "${{ secrets.DEEPSEEK_API_KEY }}" ]; then
            sed -i "s/\${DEEPSEEK_API_KEY}/${{ secrets.DEEPSEEK_API_KEY }}/g" .env 2>/dev/null || true
          fi
          if [ ! -z "${{ secrets.OPENAI_API_KEY }}" ]; then
            sed -i "s/\${OPENAI_API_KEY}/${{ secrets.OPENAI_API_KEY }}/g" .env 2>/dev/null || true
          fi
          
          # 生成API密钥
          if grep -q "your-super-secret-key" .env 2>/dev/null; then
            API_SECRET=$(openssl rand -hex 32)
            sed -i "s/your-super-secret-key-change-this-in-production/$API_SECRET/g" .env
          fi
          
          # 构建镜像
          echo "🏗️ 构建应用..."
          if [ -f "Dockerfile.simple" ]; then
            docker build -f Dockerfile.simple -t mem0:latest .
          else
            docker build -t mem0:latest .
          fi
          
          # 启动容器
          echo "🚀 启动应用..."
          docker run -d \
            --name mem0-api \
            -p 8000:8000 \
            --restart always \
            --env-file .env \
            -v /opt/mem0/data:/app/data \
            -v /opt/mem0/logs:/app/logs \
            mem0:latest
          
          # 等待启动
          echo "⏳ 等待服务启动..."
          sleep 15
          
          # 健康检查
          echo "🔍 健康检查..."
          for i in {1..6}; do
            if curl -f http://localhost:8000/health 2>/dev/null; then
              echo "✅ 服务启动成功"
              break
            else
              echo "⏳ 等待服务启动... ($i/6)"
              sleep 5
              if [ $i -eq 6 ]; then
                echo "⚠️ 健康检查失败，查看日志:"
                docker logs --tail 20 mem0-api
              fi
            fi
          done
          
          echo "🎉 部署完成！"
        EOF

  # 通知结果
  notify:
    name: 通知
    runs-on: ubuntu-latest
    needs: [test, deploy]
    if: always()
    
    steps:
    - name: 部署结果
      run: |
        if [ "${{ needs.deploy.result }}" = "success" ]; then
          echo "✅ 部署成功！"
          echo "服务地址: http://${{ secrets.SSH_HOST }}:8000"
          echo "API文档: http://${{ secrets.SSH_HOST }}:8000/docs"
        else
          echo "❌ 部署失败，请查看日志"
        fi