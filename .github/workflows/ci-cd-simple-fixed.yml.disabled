name: Mem0 rsync部署方案

on:
  push:
    branches: [ main, develop, daily/* ]
    tags: [ 'v*' ]
  pull_request:
    branches: [ main, develop ]

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  # 基础检查和测试
  test:
    name: 测试
    runs-on: ubuntu-latest
    
    steps:
    - name: 检出代码
      uses: actions/checkout@v4
      
    - name: 设置Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.11'
        cache: 'pip'
        
    - name: 安装依赖
      run: |
        python -m pip install --upgrade pip
        # 安装基础依赖进行测试
        pip install fastapi uvicorn[standard] pydantic python-dotenv loguru httpx
        pip install python-jose[cryptography] passlib[bcrypt]
        # 尝试安装AI相关依赖（允许失败）
        pip install sentence-transformers || echo "sentence-transformers安装失败，跳过"
        pip install chromadb || echo "chromadb安装失败，跳过"
        pip install sqlalchemy pymysql || echo "数据库依赖安装失败，跳过"
        
    - name: 代码格式检查（可选）
      continue-on-error: true
      run: |
        pip install black isort flake8
        black --check --diff . || true
        isort --check-only --diff . || true
        flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics || true
        
    - name: 运行单元测试
      continue-on-error: true
      run: |
        echo "🧪 运行单元测试..."
        python test_unit.py
        
        echo "📝 运行代码语法检查..."
        python -m py_compile app.py || echo "app.py 语法检查失败"
        python -m py_compile mysql_handler.py || echo "mysql_handler.py 语法检查失败"
        
        echo "✅ 单元测试完成"

  # 直接部署到服务器（使用rsync）
  deploy:
    name: 部署应用
    runs-on: ubuntu-latest
    needs: test
    # 在main分支、daily分支或标签推送时部署
    if: github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/heads/daily/') || startsWith(github.ref, 'refs/tags/v')
    
    steps:
    - name: 检出代码
      uses: actions/checkout@v4
      
    - name: 检查SSH配置
      run: |
        if [ -z "${{ secrets.SSH_HOST }}" ]; then
          echo "❌ 未配置 SSH_HOST"
          echo "请在 GitHub Settings -> Secrets 中添加 SSH_HOST"
          exit 1
        else
          echo "✅ SSH_HOST 已配置"
        fi
        
        if [ -z "${{ secrets.SSH_USER }}" ]; then
          echo "⚠️ 未配置 SSH_USER，使用默认值 root"
        else
          echo "✅ SSH_USER 已配置"
        fi
        
        if [ -z "${{ secrets.SSH_PRIVATE_KEY }}" ]; then
          echo "❌ 未配置 SSH_PRIVATE_KEY"
          echo "请在 GitHub Settings -> Secrets 中添加 SSH_PRIVATE_KEY"
          exit 1
        else
          echo "✅ SSH_PRIVATE_KEY 已配置"
        fi
    
    - name: 使用rsync部署代码
      env:
        SSH_HOST: ${{ secrets.SSH_HOST }}
        SSH_USER: ${{ secrets.SSH_USER || 'root' }}
        SSH_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
      run: |
        echo "📡 连接到服务器 $SSH_HOST"
        
        # 设置SSH
        mkdir -p ~/.ssh
        echo "$SSH_KEY" > ~/.ssh/deploy_key
        chmod 600 ~/.ssh/deploy_key
        
        # 添加服务器到已知主机
        ssh-keyscan -H $SSH_HOST >> ~/.ssh/known_hosts 2>/dev/null
        
        # 测试连接
        echo "🔍 测试SSH连接..."
        if ssh -i ~/.ssh/deploy_key -o ConnectTimeout=10 $SSH_USER@$SSH_HOST "echo '✅ SSH连接成功'"; then
          echo "SSH连接正常"
        else
          echo "❌ SSH连接失败，请检查SSH配置"
          exit 1
        fi
        
        # 检查Docker环境
        echo "🐳 检查Docker环境..."
        if ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "docker --version && docker ps"; then
          echo "✅ Docker运行正常"
        else
          echo "❌ Docker未安装或无法运行"
          echo "请确保服务器已安装Docker并正在运行："
          echo "1. 阿里云购买时选择预装Docker"
          echo "2. 或手动安装: curl -fsSL https://get.docker.com | bash"
          echo "3. 启动服务: systemctl start docker && systemctl enable docker"
          exit 1
        fi
        
        # 准备服务器目录
        echo "📂 准备服务器目录..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "mkdir -p /opt/mem0/{data,logs,backups}"
        
        # 停止旧容器
        echo "🛑 停止旧容器..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "docker stop mem0-api 2>/dev/null || echo '没有运行的容器'"
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "docker rm mem0-api 2>/dev/null || echo '没有要删除的容器'"
        
        # 备份环境配置
        echo "💾 备份配置文件..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "[ -f /opt/mem0/.env ] && cp /opt/mem0/.env /opt/mem0/data/.env.backup || echo '无需备份'"
        
        # 设置服务器SSH密钥用于Git访问
        echo "🔑 配置服务器Git SSH密钥..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "mkdir -p ~/.ssh && chmod 700 ~/.ssh"
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "ssh-keyscan github.com >> ~/.ssh/known_hosts 2>/dev/null"
        
        # 将部署密钥复制到服务器
        echo "📋 复制SSH密钥到服务器..."
        echo "$SSH_KEY" | ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "cat > ~/.ssh/id_rsa && chmod 600 ~/.ssh/id_rsa"
        
        # 配置Git SSH
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "echo 'Host github.com' > ~/.ssh/config"
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "echo '    HostName github.com' >> ~/.ssh/config"
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "echo '    User git' >> ~/.ssh/config"
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "echo '    IdentitiesOnly yes' >> ~/.ssh/config"
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "echo '    StrictHostKeyChecking no' >> ~/.ssh/config"
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST "chmod 600 ~/.ssh/config"
        
        # 执行服务器端部署
        echo "🔧 开始服务器端部署..."
        ssh -i ~/.ssh/deploy_key $SSH_USER@$SSH_HOST << 'DEPLOY'
          set -e
          
          echo "📂 准备部署环境..."
          
          # 创建临时目录
          TEMP_DIR="/tmp/mem0_deploy_$(date +%Y%m%d_%H%M%S)"
          mkdir -p "$TEMP_DIR"
          cd "$TEMP_DIR"
          
          # 使用SSH方式克隆代码
          echo "📥 使用SSH方式下载代码..."
          if git clone git@github.com:${{ github.repository }}.git .; then
            echo "✅ SSH方式下载成功"
            git checkout ${{ github.ref_name }}
          else
            echo "❌ SSH方式失败，退出部署"
            exit 1
          fi
          
          echo "🔄 同步代码到生产目录..."
          # 同步代码到生产目录（保留数据目录）
          rsync -av --delete \
                --exclude='data/' \
                --exclude='logs/' \
                --exclude='backups/' \
                --exclude='.env' \
                "$TEMP_DIR/" /opt/mem0/
          
          # 切换到生产目录
          cd /opt/mem0
          
          # 设置环境配置
          echo "⚙️ 配置环境..."
          if [ -f ".env.server" ]; then
            cp .env.server .env
          elif [ -f ".env.production.template" ]; then
            cp .env.production.template .env
          fi
          
          # 替换API密钥
          if [ ! -z "${{ secrets.DEEPSEEK_API_KEY }}" ]; then
            sed -i "s/\${DEEPSEEK_API_KEY}/${{ secrets.DEEPSEEK_API_KEY }}/g" .env
          fi
          if [ ! -z "${{ secrets.OPENAI_API_KEY }}" ]; then
            sed -i "s/\${OPENAI_API_KEY}/${{ secrets.OPENAI_API_KEY }}/g" .env
          fi
          
          # 生成API密钥
          if grep -q "your-super-secret-key" .env; then
            API_SECRET=$(openssl rand -hex 32)
            sed -i "s/your-super-secret-key-change-this-in-production/$API_SECRET/g" .env
          fi
          
          # 构建镜像（带重试）
          echo "🏗️ 构建应用..."
          for i in {1..2}; do
            if [ -f "Dockerfile.simple" ]; then
              BUILD_CMD="docker build -f Dockerfile.simple -t mem0:latest ."
            else
              BUILD_CMD="docker build -t mem0:latest ."
            fi
            
            if $BUILD_CMD; then
              echo "✅ 镜像构建成功"
              break
            else
              echo "⚠️ 镜像构建失败，第 $i 次重试..."
              docker system prune -f 2>/dev/null || true
              if [ $i -eq 2 ]; then
                echo "❌ 镜像构建失败，已重试2次"
                exit 1
              fi
              sleep 10
            fi
          done
          
          # 启动容器
          echo "🚀 启动应用..."
          docker run -d \
            --name mem0-api \
            -p 8000:8000 \
            --restart always \
            --env-file .env \
            -v /opt/mem0/data:/app/data \
            -v /opt/mem0/logs:/app/logs \
            mem0:latest
          
          # 等待启动
          echo "⏳ 等待服务启动..."
          sleep 15
          
          # 健康检查（带重试）
          echo "🔍 健康检查..."
          for i in {1..6}; do
            sleep 5
            if curl -f http://localhost:8000/health 2>/dev/null; then
              echo "✅ 服务启动成功"
              break
            else
              echo "⏳ 等待服务启动... ($i/6)"
              if [ $i -eq 6 ]; then
                echo "⚠️ 健康检查失败，查看日志:"
                docker logs --tail 20 mem0-api
                echo "🔍 容器状态:"
                docker ps | grep mem0-api || echo "容器未运行"
              fi
            fi
          done
          
          echo "🎉 部署完成！"
          
          # 清理临时目录
          echo "🧹 清理临时文件..."
          rm -rf "$TEMP_DIR"
        DEPLOY

  # 通知结果
  notify:
    name: 通知
    runs-on: ubuntu-latest
    needs: [test, deploy]
    if: always()
    
    steps:
    - name: 部署结果
      run: |
        if [ "${{ needs.deploy.result }}" = "success" ]; then
          echo "✅ 部署成功！"
          echo "服务地址: http://${{ secrets.SSH_HOST }}:8000"
          echo "API文档: http://${{ secrets.SSH_HOST }}:8000/docs"
        else
          echo "❌ 部署失败，请查看日志"
        fi