# ==========================================
# Mem0 自托管配置文件
# 请复制此文件为 .env 并修改配置
# ==========================================

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=9000
DEBUG_MODE=false
LOG_LEVEL=info

# API密钥（用于保护您的服务）
API_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# LLM 配置（选择一个使用）
# ==========================================

# 1. 阿里云通义千问 (推荐)
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=qwen-max  # 可选: qwen-turbo, qwen-plus, qwen-max

# 2. 百度文心一言
# LLM_PROVIDER=qianfan
# QIANFAN_AK=your-qianfan-ak
# QIANFAN_SK=your-qianfan-sk
# QIANFAN_MODEL=ERNIE-Bot-4  # 可选: ERNIE-Bot, ERNIE-Bot-turbo

# 3. 智谱AI
# LLM_PROVIDER=zhipu
# ZHIPUAI_API_KEY=your-zhipuai-api-key
# ZHIPUAI_MODEL=glm-4  # 可选: glm-4, glm-3-turbo

# 4. DeepSeek
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat

# 5. Moonshot AI
# LLM_PROVIDER=moonshot
# MOONSHOT_API_KEY=your-moonshot-api-key
# MOONSHOT_MODEL=moonshot-v1-8k  # 可选: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k

# ==========================================
# Embedding 配置
# ==========================================

# 1. 阿里云通义千问 Embedding (API调用)
EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_API_KEY=同上
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# 2. 百度文心 Embedding (API调用)
# EMBEDDING_PROVIDER=qianfan
# QIANFAN_EMBEDDING_MODEL=Embedding-V1

# 3. 智谱AI Embedding (API调用)
# EMBEDDING_PROVIDER=zhipu
# ZHIPUAI_EMBEDDING_MODEL=embedding-3

# 4. 本地中文嵌入模型 (推荐，完全本地，无需API)
EMBEDDING_PROVIDER=local_huggingface
HF_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5  # 最佳中文嵌入模型
# HF_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5   # 更快，稍小的中文模型
# HF_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5  # 最小的中文模型
# HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # 多语言模型

# 5. OpenAI兼容本地模型 (如Ollama)
# EMBEDDING_PROVIDER=local_openai
# LOCAL_EMBEDDING_URL=http://localhost:11434/v1
# LOCAL_EMBEDDING_MODEL=nomic-embed-text

# 6. Sentence Transformers (完全本地)
# EMBEDDING_PROVIDER=sentence_transformers
# ST_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5  # 推荐中文模型

# ==========================================
# 向量数据库配置（选择一个使用）
# ==========================================

# 1. ChromaDB (推荐，轻量级)
VECTOR_DB=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=mem0_memories

# 2. Qdrant (高性能)
# VECTOR_DB=qdrant
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_COLLECTION=mem0_memories
# QDRANT_API_KEY=

# 3. FAISS (本地文件存储)
# VECTOR_DB=faiss
# FAISS_INDEX_PATH=./data/faiss_index

# ==========================================
# 图数据库配置（可选）
# ==========================================

# Neo4j
GRAPH_DB=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ==========================================
# MySQL 数据库配置（用于存储记忆数据）
# ==========================================

ENABLE_MYSQL=false  # 设置为 true 启用 MySQL 存储
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=mem0

# ==========================================
# PostgreSQL 数据库配置（用于存储元数据）
# ==========================================

DATABASE_URL=postgresql://mem0:password@localhost:5432/mem0_db

# ==========================================
# 记忆系统配置
# ==========================================

# 记忆保留时间（天）
MEMORY_RETENTION_DAYS=365

# 记忆搜索返回数量
MEMORY_SEARCH_LIMIT=10

# 记忆更新策略
MEMORY_UPDATE_STRATEGY=merge  # 可选: replace, merge

# 中文分词配置
CHINESE_TOKENIZER=jieba  # 可选: jieba, pkuseg, thulac

# ==========================================
# 安全配置
# ==========================================

# CORS设置
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # 秒

# ==========================================
# 监控和日志
# ==========================================

# Prometheus监控
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# 日志配置
LOG_FILE_PATH=./logs/mem0.log
LOG_MAX_SIZE=100  # MB
LOG_BACKUP_COUNT=10