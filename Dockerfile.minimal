# 极简版本的Dockerfile，使用系统Python和最小依赖
# 当Docker Hub无法访问时使用此版本
FROM ubuntu:22.04

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# 安装Python和基础依赖（使用阿里云APT源加速）
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    gcc \
    g++ \
    make \
    curl \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 升级pip并安装核心依赖
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install fastapi uvicorn[standard] pydantic python-dotenv pymysql sqlalchemy loguru

# 复制应用代码
COPY . .

# 安装其他依赖（容错处理）
RUN python3 -m pip install -r requirements.txt 2>/dev/null || \
    python3 -m pip install sentence-transformers chromadb 2>/dev/null || \
    echo "部分依赖安装失败，但核心功能可用"

# 创建必要的目录
RUN mkdir -p /app/logs /app/data/chroma /app/data/huggingface /app/data/transformers

# 创建非root用户
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

# 暴露端口
EXPOSE 9000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

# 启动命令
CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "9000"]