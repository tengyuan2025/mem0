# Mem0 服务器生产环境配置
# 这个文件会在部署时自动复制到服务器

# 基础配置
ENVIRONMENT=production
API_SECRET_KEY=your-super-secret-key-change-this-in-production

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LLM配置
MEM0_LLM_PROVIDER=deepseek
MEM0_LLM_MODEL=deepseek-chat

# 嵌入模型配置
MEM0_EMBEDDER_PROVIDER=sentence_transformers
MEM0_EMBEDDER_MODEL=shibing624/text2vec-base-chinese

# 向量数据库配置
MEM0_VECTOR_STORE_PROVIDER=chroma
MEM0_VECTOR_STORE_TYPE=persistent
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# 数据目录
MEM0_DIR=/app/data
HF_HOME=/app/data/huggingface
TRANSFORMERS_CACHE=/app/data/transformers

# API密钥（请在GitHub Secrets中设置真实值）
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}

# 数据库配置（如果需要）
# DATABASE_URL=sqlite:///./data/mem0.db

# 调试配置
DEBUG=false