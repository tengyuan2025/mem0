# 本地构建版本 - 不依赖网络下载，使用系统自带组件
# 当所有网络依赖构建都失败时使用

# 使用最基础的系统镜像
FROM ubuntu:20.04

# 设置工作目录
WORKDIR /app

# 避免交互式安装
ENV DEBIAN_FRONTEND=noninteractive

# 只安装最基础的组件
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 手动安装最基础的Python包（不依赖网络）
RUN python3 -c "
import sys
print('Python version:', sys.version)

# 创建最基础的FastAPI应用
with open('/tmp/simple_app.py', 'w') as f:
    f.write('''
import json
import http.server
import socketserver
from urllib.parse import urlparse, parse_qs

class MemoryHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == \"/health\":
            self.send_response(200)
            self.send_header(\"Content-type\", \"application/json\")
            self.end_headers()
            self.wfile.write(json.dumps({\"status\": \"ok\", \"message\": \"基础服务运行中\"}).encode())
        else:
            self.send_response(404)
            self.end_headers()
    
    def do_POST(self):
        self.send_response(200)
        self.send_header(\"Content-type\", \"application/json\")
        self.end_headers()
        self.wfile.write(json.dumps({\"message\": \"基础API服务\"}).encode())

if __name__ == \"__main__\":
    PORT = 8000
    with socketserver.TCPServer((\"\", PORT), MemoryHandler) as httpd:
        print(f\"服务器启动在端口 {PORT}\")
        httpd.serve_forever()
''')
"

# 复制应用代码
COPY . .

# 创建必要的目录
RUN mkdir -p /app/logs /app/data

# 创建启动脚本
RUN echo '#!/bin/bash\n\
if python3 -c "import fastapi, uvicorn" 2>/dev/null; then\n\
    echo "启动完整应用..."\n\
    python3 -m uvicorn app:app --host 0.0.0.0 --port 8000\n\
else\n\
    echo "依赖不足，启动基础服务..."\n\
    python3 /tmp/simple_app.py\n\
fi' > /app/start.sh && chmod +x /app/start.sh

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令
CMD ["/app/start.sh"]